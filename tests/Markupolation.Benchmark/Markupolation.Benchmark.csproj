<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Configuration>Release</Configuration>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.0" />
    <PackageReference Include="AngleSharp.Diffing" Version="1.1.1" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    <PackageReference Include="HtmlTags" Version="10.0.0" />
    <PackageReference Include="HyperTextExpression" Version="0.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Set the MarkupolationLocal environment variable to measure the working tree instead of the
      published package. It has to be an environment variable, not -p:, because BenchmarkDotNet
      builds its own generated project in a child process that does not inherit -p: properties.
        pwsh: $env:MarkupolationLocal='true'; dotnet run -c Release
        cmd:  set MarkupolationLocal=true && dotnet run -c Release
    -->
    <PackageReference Include="Markupolation.Extensions" Version="2.1.0" Condition="'$(MarkupolationLocal)' != 'true'" />
    <ProjectReference Include="..\..\src\Markupolation.Extensions\Markupolation.Extensions.csproj" Condition="'$(MarkupolationLocal)' == 'true'" />
    <Using Include="Markupolation.Elements" Static="True" />
    <Using Include="Markupolation.Elements" Alias="e" />
    <Using Include="Markupolation.Attributes" Static="True" />
    <Using Include="Markupolation.Attributes" Alias="a" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Markupolation.Razor\Markupolation.Razor.csproj" />
  </ItemGroup>

</Project>
