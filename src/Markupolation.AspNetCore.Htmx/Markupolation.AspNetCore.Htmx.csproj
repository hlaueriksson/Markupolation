<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <PackageReleaseNotes>
    </PackageReleaseNotes>
    <Authors>Henrik Lau Eriksson</Authors>
    <Description>
Markupolation = Markup + String Interpolation
htmx request and response headers for ASP.NET Core:
⌨️ request.IsHtmx() ? partial : page
⌨️ response.HxTrigger("refresh");
    </Description>
    <PackageId>Markupolation.AspNetCore.Htmx</PackageId>
    <PackageProjectUrl>https://github.com/hlaueriksson/Markupolation</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>Markupolation.AspNetCore.Htmx.md</PackageReadmeFile>
    <PackageTags>HTML;HTML5;Markup;AspNetCore;htmx</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\Markupolation.AspNetCore.Htmx.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Markupolation.AspNetCore.Htmx.props" Pack="true" PackagePath="buildTransitive\Markupolation.AspNetCore.Htmx.props" />
    <None Include="buildTransitive\Markupolation.AspNetCore.Htmx.props" Pack="true" PackagePath="build\Markupolation.AspNetCore.Htmx.props" />
  </ItemGroup>

  <Import Project="../../Analyzers.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
