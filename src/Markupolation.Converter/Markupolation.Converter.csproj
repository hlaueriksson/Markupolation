<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <Authors>Henrik Lau Eriksson</Authors>
    <Description>Converts HTML into Markupolation source.</Description>
    <PackageId>Markupolation.Converter</PackageId>
    <PackageProjectUrl>https://github.com/hlaueriksson/Markupolation</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <Import Project="../../Analyzers.props" />

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.0" />
    <ProjectReference Include="..\Markupolation\Markupolation.csproj" />
  </ItemGroup>

</Project>
