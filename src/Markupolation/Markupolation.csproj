<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
    <Version>2.1.0</Version>
    <PackageReleaseNotes>
Regenerated elements and attributes from https://html.spec.whatwg.org/
Living Standard — Last Updated 8 September 2026
    </PackageReleaseNotes>
    <Authors>Henrik Lau Eriksson</Authors>
    <Description>
Markupolation = Markup + String Interpolation
HTML templating in C# with a fluent API:
⌨️ $"{DOCTYPE() + html(head(e.title("Markupolation")), body(h1("Hello, World!")))}";
🖨️ &lt;!DOCTYPE html&gt;&lt;html&gt;&lt;head&gt;&lt;title&gt;Markupolation&lt;/title&gt;&lt;/head&gt;&lt;body&gt;&lt;h1&gt;Hello, World!&lt;/h1&gt;&lt;/body&gt;&lt;/html&gt;
    </Description>
    <PackageId>Markupolation</PackageId>
    <PackageProjectUrl>https://github.com/hlaueriksson/Markupolation</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>Markupolation.md</PackageReadmeFile>
    <PackageTags>HTML;HTML5;Markup</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageValidationBaselineVersion>2.1.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\Markupolation.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Markupolation.props" Pack="true" PackagePath="buildTransitive\Markupolation.props" />
    <None Include="buildTransitive\Markupolation.props" Pack="true" PackagePath="build\Markupolation.props" />
  </ItemGroup>

  <!--
    Records get covariant return types for the compiler-synthesized <Clone>$ on runtimes that
    support them, so the public API surface differs per target framework. The analyzer only
    auto-includes PublicAPI.*.txt from the project directory, so keep them in per-TFM folders.
  -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Nest the Content partials under Content.cs in the Solution Explorer. -->
  <ItemGroup>
    <Compile Update="Content.*.cs" DependentUpon="Content.cs" />
  </ItemGroup>

  <Import Project="../../Analyzers.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Markupolation.Extensions" />
    <InternalsVisibleTo Include="Markupolation.Converter" />
    <InternalsVisibleTo Include="Markupolation.Tests" />
  </ItemGroup>

</Project>
